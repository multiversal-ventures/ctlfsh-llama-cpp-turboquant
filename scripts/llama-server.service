[Unit]
Description=llama-server with cuda-freeze watchdog
After=network.target nvidia-persistenced.service

[Service]
Type=simple
ExecStart=/usr/local/bin/llama-freeze-watchdog \
    --listen 0.0.0.0:8080 \
    --backend 127.0.0.1:2853 \
    -- \
    /usr/local/bin/llama-server \
    -m /models/gemma3-4b-it-q4_k_m.gguf \
    --cache-type-k turbo4 --cache-type-v turbo4 \
    -np 3 -c 8192 -ngl 99 \
    --host 127.0.0.1 --port 2853 \
    --cuda-freeze --sleep-idle-seconds 5
Restart=always
RestartSec=3
Environment=CUDA_VISIBLE_DEVICES=0

[Install]
WantedBy=multi-user.target
